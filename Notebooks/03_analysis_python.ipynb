   "source": [
    "monthly = (orders[orders['year_month'] >= '2017-01']\n",
    "           .groupby('year_month')\n",
    "           .agg(n_orders=('order_id', 'count'), revenue=('product_value', 'sum'),\n",
    "                aov=('payment_total', 'mean'), customers=('customer_unique_id', 'nunique')))\n",
    "monthly['mom_growth_%'] = monthly['revenue'].pct_change() * 100\n",
    "\n",
    "ytd = (orders[orders['purchase_ts'].dt.month <= 8]\n",
    "       .groupby(orders['purchase_ts'].dt.year)['product_value'].sum())\n",
    "growth = (ytd[2018] / ytd[2017] - 1) * 100\n",
    "print(f'Doanh thu tháng 1–8: 2017 = {ytd[2017]:,.0f} BRL | 2018 = {ytd[2018]:,.0f} BRL -> tăng {growth:.1f}%')\n",
    "print(f\"Tháng doanh thu cao nhất: {monthly['revenue'].idxmax()} ({monthly['revenue'].max():,.0f} BRL)\")\n",
    "monthly"
   ]
  },
