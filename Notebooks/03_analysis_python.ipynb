   "source": [
    "state = (orders.groupby('customer_state')\n",
    "         .agg(n_orders=('order_id', 'count'), revenue=('product_value', 'sum'),\n",
    "              avg_delivery_days=('delivery_days', 'mean'), late_rate_pct=('is_late', 'mean'),\n",
    "              avg_freight=('freight_value', 'mean'), avg_score=('review_score', 'mean'))\n",
    "         .sort_values('n_orders', ascending=False))\n",
    "state['late_rate_pct'] *= 100\n",
    "state['order_share_%'] = state['n_orders'] / state['n_orders'].sum() * 100\n",
    "\n",
    "top3 = state.index[:3]\n",
    "fast, slow = state['avg_delivery_days'].idxmin(), state['avg_delivery_days'].idxmax()\n",
    "print(f\"Top 3 bang ({', '.join(top3)}) chiếm {state['order_share_%'].head(3).sum():.1f}% số đơn\")\n",
    "print(f\"Giao nhanh nhất: {fast} ({state.loc[fast, 'avg_delivery_days']:.1f} ngày) | chậm nhất: {slow} ({state.loc[slow, 'avg_delivery_days']:.1f} ngày)\")\n",
    "state"
   ]
