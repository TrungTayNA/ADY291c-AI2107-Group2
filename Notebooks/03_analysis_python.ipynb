   "source": [
    "kpi = pd.Series({\n",
    "    'Số đơn hàng': len(orders),\n",
    "    'Số khách hàng (unique)': orders['customer_unique_id'].nunique(),\n",
    "    'Số người bán': master['seller_id'].nunique(),\n",
    "    'Số sản phẩm': master['product_id'].nunique(),\n",
    "    'Doanh thu hàng hoá (BRL)': orders['product_value'].sum(),\n",
    "    'Phí vận chuyển (BRL)': orders['freight_value'].sum(),\n",
    "    'Tổng thanh toán (BRL)': orders['payment_total'].sum(),\n",
    "    'Giá trị đơn trung bình - AOV (BRL)': orders['payment_total'].mean(),\n",
    "    'Số sản phẩm / đơn': orders['n_items'].mean(),\n",
    "    'Điểm review trung bình': orders['review_score'].mean(),\n",
    "    'Tỷ lệ giao trễ (%)': orders['is_late'].mean() * 100,\n",
    "    'Số ngày giao trung vị': orders['delivery_days'].median(),\n",
    "}, name='giá trị')\n",
    "kpi.to_frame()"
   ]
