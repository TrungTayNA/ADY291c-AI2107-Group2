   "source": [
    "cat = (master.groupby('product_category_name_english')\n",
    "       .agg(revenue=('price', 'sum'), n_items=('order_item_id', 'count'),\n",
    "            avg_price=('price', 'mean'), avg_score=('review_score', 'mean'))\n",
    "       .sort_values('revenue', ascending=False))\n",
    "cat['share_%'] = cat['revenue'] / cat['revenue'].sum() * 100\n",
    "cat['cum_share_%'] = cat['share_%'].cumsum()\n",
    "n80 = (cat['cum_share_%'] < 80).sum() + 1\n",
    "print(f'{n80}/{len(cat)} danh mục ({n80 / len(cat) * 100:.0f}%) tạo ra 80% doanh thu')\n",
    "cat.head(15)"
   ]
  },
